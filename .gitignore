# ==========================================
# 🔒 BẢO MẬT & TÀI KHOẢN (Environment & Secrets)
# ==========================================
**/.env*
!**/.env.example
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/credentials.json
**/secrets.json
**/serviceAccountKey.json

# ==========================================
# 📄 TÀI LIỆU NỘI BỘ & BÁO CÁO LOCAL (Docs & Reports)
# ==========================================
docs/
ERRORS.md
*.docx
*.doc
*.pdf
*.xlsx
*.pptx
*.drawio
local-docs/

# ==========================================
# 🧪 KIỂM THỬ LOCAL & CI (Tests, Scripts & CI)
# ==========================================
.github/
**/tests/
**/scripts/
**/playwright.config.ts
**/playwright-report/
**/test-results/
**/coverage/
**/.nyc_output/

# ==========================================
# 🧹 CẤU HÌNH LINTER & FORMATTER (Lint & Formatting)
# ==========================================
**/.prettier*
**/eslint.config.mjs
**/.eslintrc*

# ==========================================
# 📦 PHỤ THUỘC & THƯ VIỆN (Dependencies)
# ==========================================
**/node_modules/
**/.pnp/
**/.pnp.js

# ==========================================
# 🏗️ BẢN BUILD & BIÊN DỊCH (Build Output)
# ==========================================
**/.next/
**/.next-production/
**/out/
**/build/
**/dist/
**/*.tsbuildinfo
next-env.d.ts.bak

# ==========================================
# 📜 NHẬT KÝ & LOGS (Logs & Diagnostics)
# ==========================================
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ==========================================
# 💾 CƠ SỞ DỮ LIỆU & FILE TẠM (Database & Temp)
# ==========================================
**/*.sqlite
**/*.sqlite3
**/*.db-journal
**/*.dump
**/scratch/
**/*.tmp
**/*.temp

# ==========================================
# 💻 HỆ ĐIỀU HÀNH & EDITOR (OS & IDE Metadata)
