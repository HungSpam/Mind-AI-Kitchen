# ==========================================
# 🔒 BẢO MẬT & TÀI KHOẢN (Environment & Secrets)
# Tuyệt đối không đẩy file chứa API Key / Token lên Git
# ==========================================
**/.env*
!**/.env.example
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/credentials.json
**/secrets.json
**/serviceAccountKey.json

# ==========================================
# 📦 PHỤ THUỘC & THƯ VIỆN (Dependencies)
# ==========================================
**/node_modules/
**/.pnp/
**/.pnp.js

# ==========================================
# 🏗️ BẢN BUILD & BIÊN DỊCH (Build Output)
# ==========================================
**/.next/
**/.next-production/
**/out/
**/build/
**/dist/
**/*.tsbuildinfo
next-env.d.ts.bak

# ==========================================
# 🧪 KIỂM THỬ & BÁO CÁO (Testing & Coverage)
# ==========================================
**/coverage/
**/playwright-report/
**/test-results/
**/.nyc_output/

# ==========================================
# 📜 NHẬT KÝ & LOGS (Logs & Diagnostics)
# ==========================================
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ==========================================
# 💾 CƠ SỞ DỮ LIỆU & FILE TẠM (Database & Temp)
# ==========================================
**/*.sqlite
**/*.sqlite3
**/*.db-journal
**/*.dump
**/scratch/
**/*.tmp
**/*.temp

# ==========================================
# 💻 HỆ ĐIỀU HÀNH & EDITOR (OS & IDE Metadata)
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini
**/.vscode/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ==========================================
# 🤖 AGENT & LOCAL CACHE
# ==========================================
**/.antigravity/
**/.gemini/
