# Server-only credentials. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Public Supabase project URL and publishable key; RLS protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; only required for administrative jobs, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Set the actual HTTPS origin when deployed.
APP_ORIGIN=http://localhost:3000
# Optional shared rate limiter. Without Redis: 10 requests/minute per server instance.
# Serverless instances do NOT share this local counter; cold starts reset it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel integration aliases are also supported; configure one complete pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set true to refuse AI requests unless shared Redis is configured.
RATE_LIMIT_REQUIRE_REDIS=false
# Optional: ONLY a header overwritten by your trusted hosting proxy.
# Without it, all visitors share the 10-request/minute bucket.
TRUSTED_IP_HEADER=
